<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WEBCON BPS 2026 SDK plugins target .NET Standard 2.0 -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>WebconPdfSplitterAction.snk</AssemblyOriginatorKeyFile>
    <!-- copy NuGet dependencies (Newtonsoft.Json) to output so the plugin package is self-contained -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WEBCON.BPS.2026.SDK.Libraries" Version="26.1.6.209" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
