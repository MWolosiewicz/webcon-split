# Szablon konfiguracji serwisu splittera.
# Skopiuj do `.env` (obok docker-compose.yml) i uzupelnij wartosci.
# `.env` jest w .gitignore - sekrety nie trafiaja do repo.
# Wszystkie zmienne maja prefiks SPLITTER_ i sensowne domyslne wartosci
# (pokazane ponizej), wiec w `.env` mozna zostawic tylko te, ktore zmieniasz.

# --- API ---
# Token wymagany w naglowku "Authorization: Bearer <token>".
# Pusty = brak autoryzacji (tylko dev / siec zaufana).
SPLITTER_API_TOKEN=
# Poziom logow: DEBUG | INFO | WARNING | ERROR
SPLITTER_LOG_LEVEL=INFO
# Logowanie tekstu stron (diagnostyka klasyfikacji): per strona surowy
# fragment + fragment znormalizowany (ASCII, wielkie litery) - dokladnie
# w postaci, w jakiej klasyfikator szuka naglowkow i fraz.
SPLITTER_LOG_PAGE_TEXT=true
# Limit znakow surowego fragmentu w logu.
SPLITTER_LOG_PAGE_TEXT_RAW_CHARS=1200
# Limit znakow znormalizowanego fragmentu w logu.
SPLITTER_LOG_PAGE_TEXT_NORM_CHARS=300

# --- LLM (klasyfikacja stron niedopasowanych do slownika) ---
# false = LLM wylaczony (tylko reguly slownikowe).
SPLITTER_LLM_ENABLED=false
# Endpoint zgodny z OpenAI (np. LM Studio): http://HOST:1234/v1
SPLITTER_LLM_ENDPOINT=
SPLITTER_LLM_MODEL=
SPLITTER_LLM_TIMEOUT_SECONDS=30
# Opcjonalne pliki promptow (patrz docs/llm-prompt.md). Puste = wbudowany
# prompt. W Dockerze odkomentuj wolumen ./prompts w docker-compose.yml
# i wpisz sciezki z kontenera, np.:
#   SPLITTER_LLM_PROMPT_FILE=/app/prompts/user-prompt.txt
#   SPLITTER_LLM_SYSTEM_PROMPT_FILE=/app/prompts/system-prompt.txt
SPLITTER_LLM_PROMPT_FILE=
SPLITTER_LLM_SYSTEM_PROMPT_FILE=

# --- OCR (fallback Tesseract dla skanow bez warstwy tekstowej) ---
# true = strony ubogie w tekst ida do Tesseracta (binarka w obrazie).
SPLITTER_OCR_ENABLED=true
# Ponizej tylu znakow alfanumerycznych warstwy tekstowej -> strona do OCR.
SPLITTER_OCR_MIN_TEXT_CHARS=25
# Jezyki Tesseracta (musza byc zainstalowane w obrazie: pol, eng).
SPLITTER_OCR_LANGUAGES=pol+eng
# Rozdzielczosc renderu strony do OCR (DPI).
SPLITTER_OCR_DPI=300
# Limit czasu OCR jednej strony (sekundy).
SPLITTER_OCR_TIMEOUT_SECONDS=30
# Liczba rownoleglych watkow OCR (procesow tesseract). Render stron jest
# zawsze sekwencyjny; wiecej watkow = szybsze duze paczki, wiecej CPU/RAM.
SPLITTER_OCR_WORKERS=2

# Rownoleglosc OCR: OMP_THREAD_LIMIT (UWAGA: to NIE jest zmienna SPLITTER_).
# Surowa zmienna OpenMP - ogranicza liczbe watkow NA JEDEN proces tesseract.
# Docker wstrzykuje ja do kontenera przez env_file, tesseract dziedziczy ja
# przy starcie. Tesseract z OpenMP domyslnie bierze tyle watkow, ile rdzeni,
# wiec przy SPLITTER_OCR_WORKERS>1 bez tego limitu masz workers*rdzenie watkow
# = nadsubskrypcja (wolniej, timeouty). Zasada: workers * OMP_THREAD_LIMIT ~=
# liczba rdzeni (vCPU); OMP_THREAD_LIMIT = rdzenie na jeden proces.
# Przyklady na 4 rdzenie: workers=4 + OMP_THREAD_LIMIT=1 (maks. przepustowosc)
# albo workers=2 + OMP_THREAD_LIMIT=2 (zbalansowane). Odkomentuj, by ustawic:
#OMP_THREAD_LIMIT=1

# --- Puste strony ---
# Usuwaj puste strony z wynikow (true, domyslnie) zamiast doklejac je
# do dokumentu z wymuszona weryfikacja. false = stare zachowanie.
# Gdy usuniecie zostawiloby 0 dokumentow (np. awaria OCR), cala paczka
# trafia jako jeden "Nieznany typ dokumentu" do weryfikacji.
SPLITTER_DROP_EMPTY_PAGES=true
# Do ilu znakow alfanum. po OCR strona jest uznawana za pusta
# (0 = tylko calkiem bez tekstu; >0 lapie szum OCR na blankach). Trzymac male.
SPLITTER_EMPTY_PAGE_MAX_ALNUM=0

# --- Progi decyzji klasyfikacji ---
# Ponizej tej pewnosci dokument dostaje requiresReview.
# 0.80: sam trafiony naglowek przy domyslnej wadze 1.0 daje rowno 0.80
# i przechodzi; naglowek + 2 frazy = 1.0.
SPLITTER_MIN_AUTO_ACCEPT_CONFIDENCE=0.80
# Minimalna pewnosc, przy ktorej werdykt LLM jest w ogole brany pod uwage.
SPLITTER_MIN_REVIEW_CONFIDENCE=0.70
